# Copy to .env at the repository root and fill in the required settings.
# All project variables use MANASHELPER_; unprefixed names are ignored.

# Required Telegram bot token from @BotFather.
MANASHELPER_TELEGRAM_BOT_TOKEN=replace-with-your-bot-token

# Database: localhost for a local Python process; db for production Compose.
# Credentials below match development Compose defaults. Replace them for production.
MANASHELPER_DATASOURCE_HOST=localhost
MANASHELPER_DATASOURCE_NAME=db123
MANASHELPER_DATASOURCE_USERNAME=user123
MANASHELPER_DATASOURCE_PASSWORD=pass123

# Required base64-encoded 32-byte AES key for stored OBIS credentials. Generate once:
# uv run python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
MANASHELPER_OBIS_ENCRYPTION_KEY=

# Replace with your advertisement channel and moderation/admin chat IDs.
MANASHELPER_ADVERTISEMENT_CHANNEL_ID=-1000000000000
MANASHELPER_ADVERTISEMENT_CHANNEL_LINK=https://t.me/example
MANASHELPER_MODERATION_CHAT_ID=-1000000000001
MANASHELPER_ADMIN_CHAT_ID=-1000000000002

# Optional shared Eders password. Leave empty to disable Eders and Study week.
MANASHELPER_EDERS_PASSWORD=

# Optional Eders polling interval in minutes (15-60).
MANASHELPER_EDERS_POLL_MINUTES=15

# Production PostgreSQL port on the server loopback interface (container port remains 5432).
MANASHELPER_DB_HOST_PORT=5432

# Production Compose image tag. CI/CD overrides this with sha-<commit> or the release tag without v.
MANASHELPER_VERSION=latest

# GitHub Actions configuration (set in repository Settings > Secrets and variables > Actions).
# GitHub secret/variable names have no MANASHELPER_ prefix; runtime keys in ENV_FILE do.
# These commented entries document GitHub settings; the bot does not read them from .env.
# Secrets:
# TELEGRAM_BOT_TOKEN=<same bot token as above>
# DOCKERHUB_TOKEN=<Docker Hub access token>
# EC2_HOST=<deployment server hostname or IP>
# EC2_USER=<SSH username>
# EC2_SSH_KEY=<SSH private key>
# EC2_PORT=22
# ENV_FILE=<full contents of the completed .env with MANASHELPER_DATASOURCE_HOST=db>
# Variables:
# TELEGRAM_CHAT_ID=<chat ID for the final CI/CD summary>

# Optional local test inputs. Uncomment only when using an export or a running Postman simulation.
# MANASHELPER_EDERS_HTML_DIR=r
# MANASHELPER_EDERS_SIMULATION_PORT=4900
# MANASHELPER_FOOD_MENU_SIMULATION_URL=http://127.0.0.1:4901
# MANASHELPER_TIMETABLE_SIMULATION_URL=http://127.0.0.1:4902
# MANASHELPER_TELEGRAM_SIMULATION_URL=http://127.0.0.1:4903/telegram
