{
  "name": "manashelper-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "generate": "bun scripts/generate.mjs",
    "check:generated": "bun scripts/generate.mjs --check",
    "typecheck": "bun --bun vue-tsc --noEmit",
    "build": "bun run check:generated && bun run typecheck && bun --bun vite build",
    "test": "bun test ./tests/unit",
    "test:e2e": "bun run build && bun --bun playwright test",
    "format": "bun --bun prettier --write src tests *.ts *.json *.html scripts",
    "format:check": "bun --bun prettier --check src tests *.ts *.json *.html scripts"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/bun": "^1.3.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.1.1"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3"
}
