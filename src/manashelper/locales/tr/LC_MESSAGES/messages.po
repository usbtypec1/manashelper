msgid ""
"🍉 <b>Cafeteria menu</b>\n"
"\n"
"Choose a day below or send a command:\n"
"• <code>/yemek today</code> — today\n"
"• <code>/yemek tomorrow</code> — tomorrow\n"
"• <code>/yemek 2</code> — in N days"
msgstr ""
"🍉 <b>Yemekhane menüsü</b>\n"
"\n"
"Aşağıdan bir gün seçin veya komut gönderin:\n"
"• <code>/yemek today</code> — bugün\n"
"• <code>/yemek tomorrow</code> — yarın\n"
"• <code>/yemek 2</code> — N gün sonra"

msgid "⭐ Rate the menu:"
msgstr "⭐ Menüyü değerlendirin:"

msgid ""
"ℹ️ Usage: <code>/yemek today</code>, <code>/yemek tomorrow</code>, or "
"<code>/yemek 2</code>"
msgstr ""
"ℹ️ Kullanım: <code>/yemek today</code>, <code>/yemek tomorrow</code> veya"
" <code>/yemek 2</code>"

